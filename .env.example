# ── Server ──
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ── Authentication & Security ──
JWT_SECRET=super-secret-jwt-soundverse-enterprise-token-2026
API_KEY_SIGNING_SECRET=soundverse-hmac-sha256-signing-secret-key-expiring-urls
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Database ──
SQLITE_PATH=./data/soundverse.db

# ── Storage ──
STORAGE_DIR=./data/audio

# ── Music Provider ──
# Options: replicate | huggingface | lyria | minimax | mock
# Set to "replicate" to use meta/musicgen via Replicate ($5 free credits on signup!)
# Set to "huggingface" to use MusicGen via HF Inference (needs inference token scope)
# Set to "mock" for $0 cost testing (test keys always use mock regardless)

MUSIC_PROVIDER=replicate

# ── Replicate.com ($5 FREE credits on signup) ──
# Get your free API token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token-here

# ── Google Lyria (Gemini API) ──
# Get your free key at: https://aistudio.google.com/apikey

# ── fal.ai / MiniMax (alternative real provider) ──
# Get credits at: https://fal.ai/dashboard/keys
# FAL_KEY=your-fal-ai-key-here

# ── Mock Provider Settings (used by test keys always) ──
MOCK_LATENCY_MS=1500
MOCK_FAILURE_RATE=0.0

# ── Webhook ──
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_MS=10000
